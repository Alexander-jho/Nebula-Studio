rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Projects Collection
    match /projects/{projectId} {
      function isValidProject(data) {
        return data.keys().hasAll(['id', 'name', 'ownerId', 'canvasData', 'createdAt']) &&
               data.id is string && data.id.size() <= 128 &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
               data.ownerId == request.auth.uid &&
               data.canvasData is map &&
               data.createdAt == request.time;
      }

      allow get: if isSignedIn() && (existing().ownerId == request.auth.uid || existing().isPublic == true);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(incoming());
      
      allow update: if isOwner(existing().ownerId) && 
                      isValidId(projectId) &&
                      incoming().ownerId == existing().ownerId &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'canvasData', 'thumbnail', 'updatedAt', 'isPublic']) &&
                      incoming().updatedAt == request.time;
                      
      allow delete: if isOwner(existing().ownerId);
    }

    // 3. User Profiles
    match /users/{userId} {
      function isValidProfile(data) {
        return data.keys().hasAll(['uid', 'email']) &&
               data.uid == request.auth.uid &&
               data.email is string && data.email.size() <= 200;
      }

      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidProfile(incoming());
    }
  }
}
